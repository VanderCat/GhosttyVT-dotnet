--additional
-m64
--config
file=multi
codegen=preview
vtbls=trimmable
types=unix
--generate
com-proxies=false
empty-records=false
enum-operators=false
aggressive-inlining
callconv-member-function
cpp-attributes
disable-runtime-marshalling
file-scoped-namespaces
guid-member
macro-bindings
marker-interfaces
native-inheritance-attribute
setslastsystemerror-attribute
unmanaged-constants
vtbl-index-attribute
--log
potential-typedef-remappings
--include-directory
vendor/ghostty/include/
--file
vendor/ghostty/include/ghostty/vt/version.h
vendor/ghostty/include/ghostty/vt/types.h
vendor/ghostty/include/ghostty/vt/allocator.h
vendor/ghostty/include/ghostty/vt/build_info.h
vendor/ghostty/include/ghostty/vt/color.h
vendor/ghostty/include/ghostty/vt/color_scheme.h
vendor/ghostty/include/ghostty/vt/device.h
vendor/ghostty/include/ghostty/vt/focus.h
vendor/ghostty/include/ghostty/vt/formatter.h
vendor/ghostty/include/ghostty/vt/render.h
vendor/ghostty/include/ghostty/vt/terminal.h
vendor/ghostty/include/ghostty/vt/grid_ref.h
vendor/ghostty/include/ghostty/vt/grid_ref_tracked.h
vendor/ghostty/include/ghostty/vt/io.h
vendor/ghostty/include/ghostty/vt/osc.h
vendor/ghostty/include/ghostty/vt/sgr.h
vendor/ghostty/include/ghostty/vt/style.h
vendor/ghostty/include/ghostty/vt/sys.h
vendor/ghostty/include/ghostty/vt/key.h
vendor/ghostty/include/ghostty/vt/kitty_graphics.h
vendor/ghostty/include/ghostty/vt/modes.h
vendor/ghostty/include/ghostty/vt/mouse.h
vendor/ghostty/include/ghostty/vt/paste.h
vendor/ghostty/include/ghostty/vt/point.h
vendor/ghostty/include/ghostty/vt/screen.h
vendor/ghostty/include/ghostty/vt/search.h
vendor/ghostty/include/ghostty/vt/selection.h
vendor/ghostty/include/ghostty/vt/size_report.h
vendor/ghostty/include/ghostty/vt/snapshot.h
vendor/ghostty/include/ghostty/vt/unicode.h
vendor/ghostty/include/ghostty/vt/wasm.h
--method-class-name
Ghostty
--namespace
GhosttyVT.Interop
--output
src/generated/Interop
--prefix-strip
ghostty_
--with-enum-member-strip
*=common-prefix
-r
GhosttyMode=@GhosttyMode
